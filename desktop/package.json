{
  "name": "pos-billing-desktop",
  "version": "1.0.0",
  "description": "NiteshPro POS - Windows desktop app (Electron)",
  "main": "main.js",
  "author": "NiteshPro POS",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "pack": "npm run build:client && electron-builder --win dir",
    "dist": "npm run build:client && electron-builder --win nsis",
    "build:client": "npm --prefix ../client run build"
  },
  "build": {
    "appId": "com.pos.billing",
    "productName": "NiteshPro POS",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "electronDist": ".electron-dist",
    "afterPack": "./scripts/copy-server-deps.js",
    "files": [
      "main.js"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "**/*",
          "!**/node_modules/nodemon/**",
          "!**/node_modules/.cache/**",
          "!**/*.log",
          "!**/keys/README*"
        ]
      },
      {
        "from": "../client/dist",
        "to": "client/dist"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "NiteshPro POS"
    }
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  }
}

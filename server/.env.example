# Server configuration
PORT=5000
# MongoDB Atlas (online). Replace user/password/cluster with your own Atlas values.
# Atlas users authenticate against the admin auth DB, so authSource=admin is needed.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pos_db?authSource=admin&retryWrites=true&w=majority
# If your Node DNS-SRV resolver fails (querySrv ECONNREFUSED), use the direct form:
# MONGODB_URI=mongodb://<user>:<password>@<shard-00-00>.mongodb.net:27017,<shard-00-01>.mongodb.net:27017,<shard-00-02>.mongodb.net:27017/pos_db?ssl=true&retryWrites=true&w=majority&authSource=admin
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# License system
# Directory (relative to server/) that holds the RSA key pair
LICENSE_KEYS_DIR=keys
# Optional: enforce a specific license for ALL protected endpoints.
# Leave empty to require that at least ONE active non-expired license exists.
DEFAULT_LICENSE_ID=

# CORS
CLIENT_ORIGIN=http://localhost:5173

# ===== CLOUD SYNC (optional) =====
# The desktop app runs its OWN local MongoDB and syncs to a central cloud server
# (same codebase deployed + connected to MongoDB Atlas). When internet is ON the
# worker pushes local changes up and pulls cloud changes down; when internet is OFF
# everything keeps working locally and syncs as soon as it reconnects.
#
# CLOUD_SYNC_URL = base URL of the cloud server, e.g. https://pos-api.example.com
# CLOUD_SYNC_TOKEN = shared secret, set to the SAME value on every device AND on
#                    the cloud server deployment. Do NOT reuse JWT_SECRET.
CLOUD_SYNC_URL=
CLOUD_SYNC_TOKEN=
CLOUD_SYNC_INTERVAL=30000
